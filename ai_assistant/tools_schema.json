{
  "_comment": "Generated from TOOLS in streamlit/ai_search.py, which is what the app actually sends to the model -- documentation only.",
  "tools": [
    {
      "name": "ask_clarifying_questions",
      "description": "Ask the user for missing details BEFORE answering (e.g. which season). Put every question in ONE call, each with 2-5 short clickable options.",
      "input_schema": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "options": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question"
              ]
            }
          }
        },
        "required": [
          "questions"
        ]
      }
    },
    {
      "name": "season_stats",
      "description": "Season stats (and league ranks) for specific players or teams.",
      "input_schema": {
        "type": "object",
        "properties": {
          "subject_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "player",
              "team",
              null
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "season": {
            "type": "string",
            "description": "YYYY-YY, e.g. 2024-25"
          },
          "per_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "PerGame",
              "Totals",
              "Per36",
              null
            ]
          },
          "stats": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "stat field names, e.g. PTS, FG3_PCT, TS_PCT"
          }
        },
        "required": [
          "names",
          "season"
        ]
      }
    },
    {
      "name": "career_stats",
