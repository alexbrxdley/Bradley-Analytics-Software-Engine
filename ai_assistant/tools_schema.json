    {
      "name": "create_visualization",
      "description": "Draw the chart that answers the question; it is shown under your answer with controls for colour, style, season and more. Types: leaderboard (rank one stat; stat, top_n, filters), scatter (x_stat vs y_stat; names = highlight), shot_chart / heat_map / hex_shot_chart / zone_map (where one player/team shoots), comparison (2-6 names across several stats), career_trend (one stat across a player's seasons, up to 6 players), game_trend (one stat game by game in a season; set quarter for one quarter's numbers, e.g. 4th-quarter points), radar (all-round profile, 1-2 names), distribution (one stat across the league, names marked), clutch_clock (a player/team by quarter), animated_shot_chart (every shot of a season appearing in order), trade. If no type answers the question exactly, draw the closest one and say so in note.",
      "input_schema": {
        "type": "object",
        "properties": {
          "chart_type": {
            "type": "string",
            "enum": [
              "leaderboard",
              "scatter",
              "shot_chart",
              "heat_map",
              "hex_shot_chart",
              "zone_map",
              "animated_shot_chart",
              "comparison",
              "career_trend",
              "game_trend",
              "radar",
              "distribution",
              "clutch_clock",
              "trade"
            ]
          },
          "subject_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "player",
              "team",
              null
            ]
