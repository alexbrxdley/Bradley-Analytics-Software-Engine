          "per_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "PerGame",
              "Totals",
              "Per36",
              null
            ]
          },
          "top_n": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ascending": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "filters": {
            "type": [
              "object",
              "null"
            ],
            "description": "optional player filters",
            "properties": {
              "position": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "G, F or C"
              },
              "team": {
                "type": [
